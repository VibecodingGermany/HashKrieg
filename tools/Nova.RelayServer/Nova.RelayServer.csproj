<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Nova.RelayServer</RootNamespace>
    <AssemblyName>nova-relay</AssemblyName>
    <!-- Same sources and determinism define as every headless host
         (docs/tech/SimulationCore.md section 9). -->
    <DefineConstants>$(DefineConstants);NOVA_FIXED_POINT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\_Project\Scripts\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Project\Scripts\Simulation\**\*.cs" Link="Simulation\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Project\Scripts\Networking\**\*.cs" Link="Networking\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The sprint-14 lobby client (D-092) talks to Supabase Edge Functions and
         needs Newtonsoft.Json — the relay binary must not pull it in. -->
    <Compile Remove="..\..\Assets\_Project\Scripts\Networking\Lobby\**\*.cs" />
  </ItemGroup>

</Project>
