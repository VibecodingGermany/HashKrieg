# Intentionally invalid. Provision the real root-only file manually on the server.
NOVA_MATCH_TOKEN=REPLACE_ON_SERVER

# Explicit public listener for the dedicated relay host. Restrict this port in
# the host firewall to the intended players/operators.
NOVA_RELAY_BIND=0.0.0.0
NOVA_RELAY_PORT=47777
NOVA_RELAY_SLOT_COUNT=2
NOVA_INPUT_DELAY_TICKS=3
NOVA_RECORD_DIR=/var/lib/hashkrieg-relay/records

# Omit NOVA_RELAY_SEED to generate a fresh non-zero seed per match.

# Optional shared secret with the lobby for short-lived HMAC match tokens
# (D-093): set NOVA_RELAY_TOKEN_SECRET to exactly 64 unprefixed hexadecimal
# characters (32 bytes), provisioned manually on the server like
# NOVA_MATCH_TOKEN. Omit it to accept only the static NOVA_MATCH_TOKEN.
