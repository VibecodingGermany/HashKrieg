<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Nova.SimRunner.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Same sources and determinism define as the Unity host and SimRunner
         (docs/tech/SimulationCore.md section 9; G0-B shared-sources contract). -->
    <DefineConstants>$(DefineConstants);NOVA_FIXED_POINT;NOVA_RELAY_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\_Project\Scripts\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Project\Scripts\Simulation\**\*.cs" Link="Simulation\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The MS-1 skirmish AI (engine-free assembly) under test: same
         shared-sources contract as Core/Simulation. -->
    <Compile Include="..\..\Assets\_Project\Scripts\AI\**\*.cs" Link="AI\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The relay/lockstep network layer under test: engine-free assembly,
         same shared-sources contract (strands A1-A5 of sprint 12). -->
    <Compile Include="..\..\Assets\_Project\Scripts\Networking\**\*.cs" Link="Networking\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Relay process contract and lifecycle compiled directly into the
         engine-free test lane. -->
    <Compile Include="..\Nova.RelayServer\RelayEnvironment.cs" Link="RelayServer\RelayEnvironment.cs" />
    <Compile Include="..\Nova.RelayServer\RelayHost.cs" Link="RelayServer\RelayHost.cs" />
    <Compile Include="..\Nova.RelayServer\Program.cs" Link="RelayServer\Program.cs" />
    <!-- Performance harness sources under test (Program.cs entry point excluded). -->
    <Compile Include="..\Nova.SimRunner\PerfStatistics.cs" Link="SimRunner\PerfStatistics.cs" />
    <Compile Include="..\Nova.SimRunner\ScenarioArtifacts.cs" Link="SimRunner\ScenarioArtifacts.cs" />
    <Compile Include="..\Nova.SimRunner\TimedSimSystem.cs" Link="SimRunner\TimedSimSystem.cs" />
    <Compile Include="..\Nova.SimRunner\TimedPathfindingSystem.cs" Link="SimRunner\TimedPathfindingSystem.cs" />
    <Compile Include="..\Nova.SimRunner\Scale500PrecombatScenario.cs" Link="SimRunner\Scale500PrecombatScenario.cs" />
    <Compile Include="..\Nova.SimRunner\Determinism10000Scenario.cs" Link="SimRunner\Determinism10000Scenario.cs" />
    <Compile Include="..\Nova.SimRunner\DeterminismArtifacts.cs" Link="SimRunner\DeterminismArtifacts.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- JSON for the linked sprint-14 lobby client sources (Networking/Lobby). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- Line coverage for the linked Core/Simulation sources (they compile into
         this assembly, so the collector instruments it directly; Cobertura
         filenames carry the original Assets paths). Diagnostic only, consumed
         by tools/Nova.Coverage — not gate evidence. coverlet.msbuild hooks the
         build (/p:CollectCoverage=true); the in-proc XPlat collector produced
         empty reports on this host. -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
