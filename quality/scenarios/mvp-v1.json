      "agentCount": 500,
      "contentPromise": false,
      "requiredAssertions": [
        "no-crash",
        "no-unbounded-memory-growth",
        "all-raw-metrics-reported"
      ],
      "thresholds": {}
    },
    {
      "id": "MAC_M2_FUNCTIONAL",
      "gateUsage": [
        "G5"
      ],
      "workloadClass": "functional-baseline",
      "description": "Funktionale Apple-M2-Baseline bei 1080p und Medium-Profil.",
      "methodRef": "macM2FunctionalMethod",
      "requiredAssertions": [
        "apple-m2-hardware",
        "macos-arm64-standalone",
        "medium-profile-1920x1080",
        "functional-match-completed",
        "all-raw-metrics-reported"
      ],
      "thresholds": {
        "frameMs": {
          "unit": "ms",
          "p95Max": 33.3,
          "p99Max": 50.0
        }
      }
    },
    {
      "id": "HEADLESS_VALID_MATCH",
      "gateUsage": [
        "PR",
        "nightly",
        "weekly",
        "G3",
        "G5"
      ],
      "workloadClass": "headless-match",
      "description": "Kanonisches Match für automatisierte Kadenz und Denominator-Regel.",
      "requiredAssertions": [
        "state-hashes",
        "monotonic-ticks",
        "valid-result",
        "result-code-from-content-manifest",
        "end-tick",
        "winner-and-loser-or-null-for-draw",
        "core-action-trace",
        "checkpoint-chain"
      ],
      "failedRunsRemainInDenominator": true
    },
    {
      "id": "G5_UI_ONLY",
      "gateUsage": [
        "G5"
      ],
      "workloadClass": "manual-acceptance",
      "description": "Zwei normale UI-only-Matches, eines pro Fraktion, ohne Debug-Mutation.",
      "requiredAssertions": [
        "one-match-per-faction",
        "normal-ui-only",
        "no-debug-mutation",
        "autosave-every-five-minutes",
        "no-gate-critical-quarantine"
      ],
      "thresholds": {
        "manualMatchCount": {
          "unit": "matches",
          "equals": 2
        },
        "freshPlayerTaskTesterCount": {
          "unit": "testers",
          "minimum": 3
        },
        "matchMedianMinutes": {
          "unit": "minutes",
          "minimum": 20,
          "maximum": 35
        },
        "autosaveEarliestCoveredMinute": {
          "unit": "minutes",
          "equals": 5
        },
        "autosaveLatestCoveredMinute": {
          "unit": "minutes",
          "equals": 45
        },
        "p0DefectCount": {
          "unit": "defects",
          "maximum": 0
        },
        "p1DefectCount": {
          "unit": "defects",
          "maximum": 0
        }
      }
    }
