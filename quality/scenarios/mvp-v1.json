  "scenarios": [
    {
      "id": "DETERMINISM_10000",
      "gateUsage": [
        "G1",
        "V1"
      ],
      "workloadClass": "determinism",
      "description": "Identischer kanonischer Replay-Strom auf Windows x64 und macOS arm64.",
      "ticks": 10000,
      "activeSlots": 2,
      "requiredAssertions": [
        "exact-state-hash-every-checkpoint",
        "exact-final-snapshot-bytes",
        "managed-path-only",
        "same-sources-and-determinism-defines"
      ]
    },
    {
      "id": "SNAPSHOT_CONTINUATION_1000",
      "gateUsage": [
        "G1"
      ],
      "workloadClass": "persistence",
      "description": "Roundtrip und Fortsetzung mit bereits gequeuten Commands.",
      "continuationTicks": 1000,
      "requiredAssertions": [
        "serialize-deserialize-serialize-byte-identical",
        "fresh-host-and-restored-host-hashes-identical",
        "fresh-host-and-restored-host-final-bytes-identical",
        "per-block-hash-sensitivity"
      ]
    },
    {
      "id": "SCALE_500_RENDERING",
      "gateUsage": [
        "G1",
        "V2"
      ],
      "workloadClass": "synthetic-presentation-headroom",
      "description": "500 sichtbare Proxy-Objekte im kanonischen URP-Renderingpfad.",
      "objectCount": 500,
      "contentPromise": false,
      "methodRef": "performanceMethod",
      "requiredAssertions": [
        "urp-production-path",
        "no-crash",
        "all-raw-metrics-reported"
      ],
      "thresholds": {
        "renderingCpuMs": {
          "unit": "ms",
          "p95Max": 4.0
        }
      }
    },
    {
      "id": "SCALE_500_ANIMATION",
      "gateUsage": [
        "G1",
        "V3"
      ],
      "workloadClass": "synthetic-presentation-headroom",
      "description": "500 sichtbare animierte Proxy-Objekte im kanonischen Animationspfad.",
      "objectCount": 500,
      "contentPromise": false,
      "methodRef": "performanceMethod",
